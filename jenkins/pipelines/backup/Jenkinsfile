pipeline {
  agent any

  environment {
    DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
    IMAGE_NAME = 'mateimonicamihaela/backup:latest'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Lint & Test Python') {
      steps {
        sh '''
          set -e
          # Lint minim fara sa stricam pipeline-ul daca lipseste flake8/pytest
          python3 -m pip install --user --upgrade pip >/dev/null 2>&1 || true
          python3 -m pip install --user flake8 pytest >/dev/null 2>&1 || true
          ~/.local/bin/flake8 scripts/backup.py || true
          ~/.local/bin/pytest -q || true
        '''
      }
    }

    stage('Build imagine Docker (backup)') {
      steps {
        sh 'docker build -t ${IMAGE_NAME} -f docker/backup/Dockerfile .'
      }
    }

    stage('Push imagine Docker (backup)') {
      steps {
        withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS}", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
          sh '''
            echo "$PASS" | docker login -u "$USER" --password-stdin
            docker push ${IMAGE_NAME}
            docker logout
          '''
        }
      }
    }

    stage('Deploy pe server (Ansible)') {
      environment {
        PATH = "/var/lib/jenkins/.local/bin:${env.PATH}"
        LANG = "C.UTF-8"
        LC_ALL = "C.UTF-8"
        PYTHONIOENCODING = "UTF-8"
      }
      steps {
        sh '''
          set -e
          echo "[INFO] Verific Ansible..."
          python3 -m pip install --user --upgrade "pip<24.1" >/dev/null 2>&1 || true
          python3 -m pip install --user "ansible==9.*"
          ansible --version

          echo "[INFO] Instalez colectiile necesare (community.docker compatibil cu 2.16)..."
          cd ansible
          ansible-galaxy collection install -r requirements.yml -f

          echo "[INFO] Rulez playbook-ul de deploy..."
          ansible-playbook -i inventory.ini playbooks/deploy_platform.yml
        '''
      }
    }
  }

  post {
    success { echo 'Pipeline Backup finalizat cu succes!' }
    failure { echo 'Eroare in pipeline Backup!' }
  }
}
