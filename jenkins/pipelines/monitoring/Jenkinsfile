pipeline {
    agent any

    options {
        // evităm "Declarative: Checkout SCM" implicit (avem deja stage-ul Checkout)
        skipDefaultCheckout(true)
        timestamps()
    }

    environment {
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
        GIT_CREDENTIALS       = 'github-ssh'
        IMAGE_NAME            = 'mateimonicamihaela/monitoring:latest'
        // Fortam UTF-8 pentru tot pipeline-ul
        LANG                  = 'C.UTF-8'
        LC_ALL                = 'C.UTF-8'
        PYTHONIOENCODING      = 'UTF-8'
    }

    stages {
        stage('Checkout') {
            steps {
                // DOAR asta, folosește SCM-ul setat la job
                checkout scm
            }
        }

        stage('Verificare sintaxa Bash') {
            steps {
                sh 'bash -n scripts/monitoring.sh'
            }
        }

        stage('Construire imagine Docker') {
            steps {
                sh 'docker build -t ${IMAGE_NAME} -f docker/monitoring/Dockerfile .'
            }
        }

        stage('Publicare imagine Docker') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS}", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh '''
                    echo "$PASS" | docker login -u "$USER" --password-stdin
                    docker push ${IMAGE_NAME}
                    docker logout
                    '''
                }
            }
        }

        stage('Deploy pe server (prin Ansible)') {
            steps {
                sh '''
                    set -e

                         # Siguranță: exportam din nou locale-urile în subshell-ul acestui stage
                        export LANG="${LANG:-C.UTF-8}"
                        export LC_ALL="${LC_ALL:-C.UTF-8}"
                        export PYTHONIOENCODING="${PYTHONIOENCODING:-UTF-8}"

                        echo "[INFO] Upgrade ansible pe agentul Jenkins (user-local)..."
                        python3 -m pip install --user --upgrade "pip<24.1" || true
                        python3 -m pip install --user "ansible==9.*"
                        export PATH="$HOME/.local/bin:$PATH"
                        ansible --version

                        echo "[INFO] Instalez colectiile Ansible necesare (community.docker compatibile cu 2.16)..."
                        cd ansible
                        ansible-galaxy collection install -r requirements.yml -f

                        echo "[INFO] Rulez playbook-ul cu inventarul explicit..."
                        ansible-playbook -i inventory.ini playbooks/deploy_platform.yml
                '''
            }
        }
    }

    post {
        success { echo 'Pipeline Monitoring finalizat cu succes!' }
        failure { echo 'Eroare în pipeline Monitoring!' }
    }
}
