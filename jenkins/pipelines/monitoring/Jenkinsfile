pipeline {
    agent any

    options {
        // evităm "Declarative: Checkout SCM" implicit (avem deja stage-ul tău Checkout)
        skipDefaultCheckout(true)
        timestamps()
        ansiColor('xterm')
    }

    environment {
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
        GIT_CREDENTIALS = 'github-ssh'   // (nefolosit acum); 
        IMAGE_NAME = 'mateimonicamihaela/monitoring:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                // DOAR asta, folosește SCM-ul setat la job
                checkout scm
            }
        }

        stage('Verificare sintaxă Bash') {
            steps {
                sh 'bash -n scripts/monitoring.sh'
            }
        }

        stage('Construire imagine Docker') {
            steps {
                sh 'docker build -t ${IMAGE_NAME} -f docker/monitoring/Dockerfile .'
            }
        }

        stage('Publicare imagine Docker') {
            steps {
                withCredentials([usernamePassword(credentialsId: "${DOCKERHUB_CREDENTIALS}", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh '''
                    echo "$PASS" | docker login -u "$USER" --password-stdin
                    docker push ${IMAGE_NAME}
                    docker logout
                    '''
                }
            }
        }

        stage('Deploy pe server (prin Ansible)') {
            steps {
                sh '''
                    set -e

                    echo "[INFO] Verific/instalez Ansible pe agentul Jenkins..."
                    if ! command -v ansible >/dev/null 2>&1; then
                        if command -v apt-get >/dev/null 2>&1; then
                            sudo apt-get update -y
                            sudo apt-get install -y ansible python3-pip
                        else
                            echo "[WARN] Nu pot instala ansible automat (nu există apt-get); continui și presupun că e instalat."
                        fi
                    fi
                    ansible --version || true

                    echo "[INFO] Instalez colecțiile Ansible necesare (community.docker)..."
                    cd ansible
                    ansible-galaxy collection install -r requirements.yml -f

                    echo "[INFO] Rulez playbook-ul cu inventarul explicit..."
                    ansible-playbook -i inventory.ini playbooks/deploy_platform.yml
                '''
            }
        }
    }

    post {
        success { echo 'Pipeline Monitoring finalizat cu succes!' }
        failure { echo 'Eroare în pipeline Monitoring!' }
    }
}
